<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/chartTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_medium"
        android:text="@string/glance_chart_title"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/chartNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@string/font_regular"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp" />

    <com.gathin.tvhome.DollarChartView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/chartEmpty"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@string/font_regular"
        android:gravity="center"
        android:text="@string/glance_chart_empty"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnChartClose"
        style="@style/TopButton"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:layout_marginStart="0dp"
        android:text="@string/glance_chart_close" />
</LinearLayout>
