<?xml version="1.0" encoding="utf-8"?>
<!-- Dólar e temperatura ao lado do relógio. Some até a primeira leitura (ou o cache) chegar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeGlance"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:baselineAlignedChildIndex="0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/dollarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_bg"
        android:clickable="true"
        android:clipChildren="false"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusDown="@id/grid"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/dollarValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false"
            android:textColor="@drawable/pill_text"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/dollarArrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/dollarChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:duplicateParentState="true"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/pill_bg"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/weatherIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/weatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
